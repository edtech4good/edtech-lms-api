# EdTech LMS API Configuration
# Copy this file to .env and fill in your actual values

# Application Configuration
FORTYKAPICONFIG={"fortyk":{"api":{"applicationapikey":"your-256-character-api-key-here","accessexpirationminutes":60,"refreshexpirationminutes":1440,"changepasswordexpirationminutes":30,"verifyemailexpirationminutes":60,"port":3000,"applicationsecret":"your-application-secret-here","serversynckey":"your-server-sync-key-here","serverip":"127.0.0.1","servername":"localhost","applicationname":"LMS-API","debug":true,"database":{"name":"edtech_lms","user":"your-db-user","password":"your-db-password","host":"localhost","port":3306},"smtp":{"host":"smtp.gmail.com","port":587,"username":"your-email@gmail.com","password":"your-email-password","secure":false,"requiretsl":true,"emailfrom":"your-email@gmail.com"},"aws":{"accesskeyid":"your-aws-access-key","secretaccesskey":"your-aws-secret-key","s3bucketname":"your-s3-bucket-name","endpoint":"https://s3.amazonaws.com"},"rpi":{"RPIsecret":"your-rpi-secret","cloud":"your-cloud-endpoint"}},"ui":"http://localhost:3001"}}

# Database Configuration (Alternative format)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edtech_lms
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@gmail.com

# Application Settings
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# TRUST_PROXY: leave unset (direct exposure, e.g. local dev / the Pi). Set to 1 only when running behind exactly one reverse proxy (UAT/prod Caddy) — otherwise a client can spoof X-Forwarded-For to dodge the login rate limit.

# LOG_IMPORT_ENABLED: leave unset. Off by default; when off, `PUT log/import` (the classroom activity-log upload) returns 404. Set to "true" or "1" only for a deployment with classroom Pis that still uses this upload path. See https://edtech4good.github.io/docs/architecture/sync.html.

# SYNC_FORMAT_DEFAULT: unset means 2 (the content sent to the student API is the whole platform's, as it always was; learner and teacher pushes keep their old shape; only a platform user who is not acting as an organisation can sync). Set it to 3 (one organisation's content, rosters that name their school) once the student API's organisation import (rpi#101 to #103) is deployed on EVERY server central pushes to: an older student API reads one organisation's file as the whole platform's and replaces everything it holds. A later change will make 3 the default. Any value other than 2 or 3 stops the server from starting.
