  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node build/server.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node build/server.js",
    "test": "jest",
    "db:migrate": "npx sequelize-cli db:migrate",
    "seed:local": "node scripts/seed-local-dev.js",
    "seed:demo": "node scripts/seed-demo-content.js",
    "seed:dcrs": "node scripts/seed-dcrs-content.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "model-gen": "sequelize-auto -h localhost -d test -u root -x password --dialect mysql -o ./path/to/models -l ts"
  },
